<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Logs go to stderr so stdout carries only decisions. MDC shows only when set. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30}%replace(%mdc){'^(.+)$', ' [$1]'} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
